[Unit]
Description=WLTraders landing and visitor analytics
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wltraders.landing
Environment=ANALYTICS_DB=/var/lib/wltraders-analytics/visitors.sqlite3
ExecStart=/usr/bin/python3 /var/www/wltraders.landing/analytics_server.py --host 127.0.0.1 --port 8090
Restart=always
RestartSec=3
StateDirectory=wltraders-analytics
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/wltraders.landing

[Install]
WantedBy=multi-user.target
